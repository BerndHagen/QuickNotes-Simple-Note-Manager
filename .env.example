# Supabase Configuration
# Create a ".env" file in the project directory and add these values:

# Supabase Project URL
# Found at: https://app.supabase.com -> Your Project -> Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (preferred for new projects)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Legacy anon key (use this only when no publishable key is available)
# Safe for frontend use when Row Level Security is enabled.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# NOTE: NEVER put the service_role key in frontend code!
# The service_role key bypasses Row Level Security and must only be used server-side.
